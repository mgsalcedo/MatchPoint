# MatchPoint — Supabase admin/CLI environment (NOT read by the browser app)
# Copy to supabase/.env and fill in. supabase/.env is gitignored and must never be committed.
# Used only for running migrations/seed via the Supabase CLI or psql — not shipped to the client.

# Postgres connection string: Supabase dashboard → Connect (top bar) or Settings → Database.
SUPABASE_DB_URL=postgres://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# service_role key: bypasses RLS. Only for local admin scripts. NEVER commit it, NEVER put it in app/.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
