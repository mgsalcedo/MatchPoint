# MatchPoint app — environment variables (Vite exposes only VITE_-prefixed vars to the client)
# Copy this file to app/.env.local and fill in the values from your Supabase project
# (Supabase dashboard → Settings → API). app/.env.local is gitignored and must never be committed.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The "anon" / "public" key. Safe to ship in the client bundle — it identifies the project,
# not a privileged session; Row Level Security (not key secrecy) protects the data.
# NEVER put the service_role key here — it bypasses RLS and must never reach the client.
VITE_SUPABASE_ANON_KEY=your-anon-public-key
